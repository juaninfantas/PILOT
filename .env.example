# Copiá a .env y completá con tu proyecto Supabase (Settings → API)

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Opcional — User-Agent para Nominatim (geocoding)
# VITE_NOMINATIM_USER_AGENT=PilotCRM/1.0 (contact@tu-dominio.com)

# Opcional — URL o mailto para el botón "Contratar" (plan Pro): landing /dashboard/planes/pro
# VITE_SALES_CONTACT_URL=mailto:hola@pilot.app?subject=Pilot%20Pro
